{
  "id": "kitchen_place_weather_popup_open",
  "alias": "Kitchen place weather popup: open",
  "description": "Opens the #place-weather pop-up on the Show dashboard when Claude's get_place_weather answers a question from the Kitchen Echo (place_weather_shown event); the home pop-up closes first.",
  "triggers": [
    {
      "trigger": "event",
      "event_type": "place_weather_shown"
    }
  ],
  "conditions": [
    {
      "condition": "template",
      "value_template": "{{ trigger.event.data.device_id == '41248314eeef303ff96af4da61090f36' }}"
    }
  ],
  "actions": [
    {
      "action": "input_boolean.turn_off",
      "target": {
        "entity_id": "input_boolean.kitchen_weather_popup"
      }
    },
    {
      "action": "input_boolean.turn_on",
      "target": {
        "entity_id": "input_boolean.kitchen_place_weather_popup"
      }
    }
  ],
  "mode": "queued"
}
