{
  "id": "planes_overhead_count",
  "alias": "Planes overhead count",
  "description": "counter.planes_today: +1 per aircraft entering the Flightradar24 area that is worth showing (not plane_boring: flight-school and local VFR traffic), reset at midnight. Feeds the poster footer. Also clears todo.plane_posters_today (the kinds that had a poster, see planes_overhead_takeover) at midnight. Also turns the poster (input_boolean.plane_takeover) off if it has been on for 40 s: saving the takeover automation mid-poster once cancelled the run that turns it off, and the Show sat on an empty red poster for ten minutes (2026-11-04). Source: ha-dashboard/automations/planes_overhead_count.json",
  "mode": "queued",
  "max": 20,
  "triggers": [
    {
      "trigger": "event",
      "event_type": "flightradar24_entry",
      "id": "entry"
    },
    {
      "trigger": "time",
      "at": "00:00:00",
      "id": "midnight"
    },
    {
      "trigger": "state",
      "entity_id": "input_boolean.plane_takeover",
      "to": "on",
      "for": {
        "seconds": 40
      },
      "id": "stuck"
    }
  ],
  "conditions": [],
  "actions": [
    {
      "choose": [
        {
          "conditions": [
            {
              "condition": "trigger",
              "id": "entry"
            },
            {
              "condition": "template",
              "value_template": "{% from 'planes.jinja' import plane_boring %}{{ not (plane_boring(trigger.event.data) | trim) }}"
            }
          ],
          "sequence": [
            {
              "action": "counter.increment",
              "target": {
                "entity_id": "counter.planes_today"
              }
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "trigger",
              "id": "midnight"
            }
          ],
          "sequence": [
            {
              "action": "counter.reset",
              "target": {
                "entity_id": "counter.planes_today"
              }
            },
            {
              "action": "todo.get_items",
              "target": {
                "entity_id": "todo.plane_posters_today"
              },
              "response_variable": "posters"
            },
            {
              "if": [
                {
                  "condition": "template",
                  "value_template": "{{ posters['todo.plane_posters_today']['items'] | count > 0 }}"
                }
              ],
              "then": [
                {
                  "action": "todo.remove_item",
                  "target": {
                    "entity_id": "todo.plane_posters_today"
                  },
                  "data": {
                    "item": "{{ posters['todo.plane_posters_today']['items'] | map(attribute='summary') | list }}"
                  }
                }
              ]
            }
          ]
        },
        {
          "conditions": [
            {
              "condition": "trigger",
              "id": "stuck"
            }
          ],
          "sequence": [
            {
              "action": "input_boolean.turn_off",
              "target": {
                "entity_id": "input_boolean.plane_takeover"
              }
            }
          ]
        }
      ]
    }
  ]
}
